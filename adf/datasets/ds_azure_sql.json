{
    "name": "ds_azure_sql",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "description": "Parameterized Azure SQL dataset.",
        "linkedServiceName": { "referenceName": "ls_azure_sql_store_a", "type": "LinkedServiceReference" },
        "parameters": {
            "SchemaName": { "type": "String", "defaultValue": "dbo" },
            "TableName": { "type": "String" }
        },
        "type": "AzureSqlTable",
        "typeProperties": {
            "schema": { "value": "@dataset().SchemaName", "type": "Expression" },
            "table": { "value": "@dataset().TableName", "type": "Expression" }
        }
    }
}
