{
    "name": "pl_landing_to_bronze",
    "properties": {
        "description": "Copies flat files (CSV) from the landing container to bronze as Parquet. Handles product reviews and future flat file sources.",
        "activities": [
            {
                "name": "Copy_Reviews_CSV_To_Parquet",
                "description": "Convert product_reviews.csv from landing to Parquet in bronze",
                "type": "Copy",
                "dependsOn": [],
                "policy": { "timeout": "0.00:15:00", "retry": 2, "retryIntervalInSeconds": 30 },
                "typeProperties": {
                    "source": {
                        "type": "DelimitedTextSource",
                        "storeSettings": { "type": "AzureBlobFSReadSettings", "recursive": false }
                    },
                    "sink": {
                        "type": "ParquetSink",
                        "storeSettings": { "type": "AzureBlobFSWriteSettings" }
                    }
                },
                "inputs": [{
                    "referenceName": "ds_config_csv",
                    "type": "DatasetReference"
                }],
                "outputs": [{
                    "referenceName": "ds_parquet_bronze",
                    "type": "DatasetReference",
                    "parameters": {
                        "Container": "bronze",
                        "FolderPath": "product_reviews",
                        "FileName": "product_reviews.parquet"
                    }
                }]
            }
        ],
        "annotations": ["flat-file", "csv-to-parquet"],
        "folder": { "name": "ecommerce_ingestion" }
    }
}
